---
import BaseLayout from "../layouts/BaseLayout.astro";

const courses = [
  {
    code: "PSYCH315H/615",
    title: "Honors Cognitive Psychology / Cognitive Psychology & Neuroscience",
    href: "/files/PSYCH315H-615_Syllabus.pdf",
  },
  {
    code: "PSYCH391MB",
    title: "Brains, Minds, & Machines",
    href: "/files/PSYCH391MB_Syllabus.pdf",
  },
  {
    code: "PSYCH891",
    title: "Cognitive and Neural Development",
    href: "/files/PSYCH891_Syllabus.pdf",
  },
];
---

<BaseLayout
  title="Teaching | Lauren Aulet"
  description="Course syllabi for Lauren Aulet's courses in cognitive psychology, neuroscience, and development at UMass Amherst."
>
  <header class="site-header">
    <a class="brand" href="/">Lauren Aulet</a>
    <nav aria-label="Primary navigation">
      <a href="/#about">About</a>
      <a href="/#research">Research</a>
      <a href="/#publications">Publications</a>
      <a href="/teaching/" aria-current="page">Teaching</a>
      <a href="/elsewhere/">Elsewhere</a>
      <a href="/files/Aulet_CV.pdf">CV</a>
    </nav>
  </header>

  <main>
    <section class="page-hero">
      <p class="eyebrow">UMass Amherst</p>
      <h1>Teaching</h1>
      <p>Syllabi for my courses at the University of Massachusetts Amherst.</p>
    </section>

    <section class="course-list" aria-label="Courses and syllabi">
      {courses.map((course) => (
        <a class="course" href={course.href} type="application/pdf">
          <p class="course-code">{course.code}</p>
          <h2>{course.title}</h2>
          <span class="syllabus-link">View syllabus <span class="file-type">PDF</span><span aria-hidden="true">↗</span></span>
        </a>
      ))}
    </section>
  </main>
</BaseLayout>

<style>
  :global(*) { box-sizing: border-box; }
  :global(body) {
    margin: 0;
    color: #191919;
    background: #fafafa;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }
  :global(a) { color: inherit; }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 14px clamp(18px, 4vw, 52px);
    background: rgba(250, 250, 250, 0.96);
    border-bottom: 1px solid #d8d8d8;
    backdrop-filter: blur(8px);
  }
  .brand {
    font-weight: 800;
    text-decoration: none;
  }
  .brand::after {
    content: " / teaching";
    color: #777;
    font-weight: 500;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    font-size: 0.92rem;
  }
  nav a { text-decoration: none; }
  nav a:hover,
  nav a[aria-current="page"] {
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  .page-hero {
    padding: clamp(54px, 8vw, 96px) clamp(18px, 4vw, 52px);
    background:
      linear-gradient(#e7e7e7 1px, transparent 1px),
      linear-gradient(90deg, #e7e7e7 1px, transparent 1px),
      #fafafa;
    background-size: 44px 44px;
    border-bottom: 1px solid #d8d8d8;
  }
  .page-hero::before {
    content: "";
    display: block;
    width: 44px;
    height: 6px;
    margin-bottom: 18px;
    background: repeating-linear-gradient(90deg, #191919 0 6px, transparent 6px 11px);
  }
  .eyebrow,
  .course-code {
    color: #555;
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
  }
  .eyebrow { margin: 0 0 14px; }
  h1,
  h2,
  p { margin-top: 0; }
  h1 {
    margin-bottom: 22px;
    font-size: clamp(3.3rem, 7vw, 6.2rem);
    line-height: 0.94;
    font-weight: 850;
  }
  .page-hero p:last-child {
    max-width: 720px;
    margin-bottom: 0;
    font-size: 1.04rem;
    line-height: 1.7;
  }

  .course {
    display: grid;
    grid-template-columns: 170px minmax(0, 1fr) auto;
    align-items: start;
    gap: 24px;
    padding: clamp(32px, 4vw, 52px) clamp(18px, 4vw, 52px);
    border-bottom: 1px solid #d8d8d8;
    text-decoration: none;
    transition: background-color 160ms ease, color 160ms ease;
  }
  .course-code { margin: 6px 0 0; }
  .course h2 {
    max-width: 800px;
    margin: 0;
    font-size: clamp(1.65rem, 2.7vw, 2.7rem);
    line-height: 1.08;
    font-weight: 820;
    overflow-wrap: break-word;
  }
  .syllabus-link {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 6px;
    font-size: 0.92rem;
    font-weight: 650;
    white-space: nowrap;
  }
  .file-type {
    border: 1px solid currentColor;
    padding: 3px 5px;
    font-size: 0.65rem;
    line-height: 1;
  }
  .course:hover,
  .course:focus-visible {
    color: #fff;
    background: #191919;
  }
  .course:hover .course-code,
  .course:focus-visible .course-code { color: #fff; }
  .course:focus-visible { outline-offset: -4px; }

  @media (max-width: 860px) {
    .site-header {
      position: static;
      align-items: flex-start;
      flex-direction: column;
    }
    .course {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .course-code,
    .syllabus-link { margin-top: 0; }
  }
  @media (max-width: 560px) {
    .brand::after { content: ""; }
  }
  @media (prefers-reduced-motion: reduce) {
    .course { transition: none; }
  }
</style>
